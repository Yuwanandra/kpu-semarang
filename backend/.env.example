# === Database (Neon PostgreSQL) ===
# Ambil dari Neon Dashboard > Connection Details > "Pooled connection"
DATABASE_URL=postgresql://neondb_owner:npg_tkNAxD0F4QRX@ep-falling-butterfly-azg0qg5p-pooler.c-3.ap-southeast-1.aws.neon.tech/neondb?sslmode=require&channel_binding=require

# === Server ===
PORT=4000
NODE_ENV=production

# === CORS: domain frontend yang diizinkan (pisahkan dengan koma) ===
CORS_ORIGINS=https://kpu-semarang.vercel.app,http://localhost:5173

# === JWT Auth (khusus admin/CMS internal) ===
JWT_SECRET=ganti-dengan-string-acak-minimal-64-karakter
JWT_EXPIRES_IN=2h
COOKIE_SECRET=ganti-dengan-string-acak-lain-minimal-64-karakter

# === Rate limiting terdistribusi (Upstash Redis) ===
# Wajib diisi jika deploy ke Vercel (serverless, tanpa memori persisten)
# Buat gratis di https://upstash.com
UPSTASH_REDIS_REST_URL=https://xxxx.upstash.io
UPSTASH_REDIS_REST_TOKEN=xxxxxxxxxxxx

# === Admin awal (dipakai oleh db/seed.js untuk membuat akun pertama) ===
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=freesemarang

# === Opsional: Cloudflare Turnstile untuk anti-bot form kontak ===
TURNSTILE_SECRET_KEY=
